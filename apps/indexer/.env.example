# Postgres (Neon free tier works for dev)
DATABASE_URL=postgres://user:password@host/dbname

# Chain RPC. Falls back to the public rate-limited endpoint if unset —
# fine for a smoke test, not for sustained ingestion.
ALCHEMY_API_KEY=
RPC_HTTP_URL=https://rpc.mainnet.chain.robinhood.com
RPC_WSS_URL=wss://feed.mainnet.chain.robinhood.com

# Uniswap V3 on Robinhood Chain — see docs/DEX_REGISTRY.md
FACTORY_ADDRESS=0x1f7d7550b1b028f7571e69a784071f0205fd2efa
FACTORY_CREATED_BLOCK=8930

HEALTH_PORT=8787

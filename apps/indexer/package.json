{
  "name": "@retinaos/indexer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env.local --import tsx/esm --watch src/index.ts",
    "start": "node --env-file=.env.local --import tsx/esm src/index.ts",
    "migrate": "node --env-file=.env.local --import tsx/esm src/db/migrate.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "viem": "^2.21.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
